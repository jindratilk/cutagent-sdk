                Height = Input { Value = 1080, },
                TopLeftRed = Input { Value = 0.06, },
                TopLeftGreen = Input { Value = 0.16, },
                TopLeftBlue = Input { Value = 0.23, },
                TopLeftAlpha = Input { Value = 1, },
                EffectMask = Input { SourceOp = "CardMask", Source = "Mask", },
            },
            ViewInfo = OperatorInfo { Pos = { 220, 150 } },
        },
        Title = TextPlus {
            Inputs = {
